{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leadline.dev/schema/replay-artifact.schema.json",
  "title": "Leadline per-completion replay artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "completion_id", "session_id", "turn_id", "completion_sha256", "strata", "detector", "evidence_receipts", "finalization_report", "label_record", "coverage"],
  "properties": {
    "schema_version": { "const": 1 },
    "completion_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "turn_id": { "type": "string", "minLength": 1 },
    "completion_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "strata": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "detector": { "type": "object" },
    "evidence_receipts": { "type": "array", "items": { "type": "object" } },
    "finalization_report": { "type": "object" },
    "label_record": { "type": ["object", "null"] },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampled", "keyword_candidate_count", "zero_candidate", "detector_status", "detector_failure", "evidence_contact_count", "obligation_count"],
      "properties": {
        "sampled": { "const": true },
        "keyword_candidate_count": { "type": "integer", "minimum": 0 },
        "zero_candidate": { "type": "boolean" },
        "detector_status": { "enum": ["ok", "unavailable", "invalid_response"] },
        "detector_failure": { "type": ["string", "null"] },
        "evidence_contact_count": { "type": "integer", "minimum": 0 },
        "obligation_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
