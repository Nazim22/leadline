{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leadline.dev/schema/replay-corpus.schema.json",
  "title": "Leadline frozen replay corpus row",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "completion_id", "session_id", "turn_id", "completed_at", "completion", "strata", "tool_calls"],
  "properties": {
    "schema_version": { "const": 1 },
    "completion_id": { "type": "string", "pattern": "^completion-[a-f0-9]{24}$" },
    "session_id": { "type": "string", "pattern": "^session-[a-f0-9]{24}$" },
    "turn_id": { "type": "string", "pattern": "^turn-[0-9]+$" },
    "completed_at": { "type": "string", "format": "date-time" },
    "completion": { "type": "string", "minLength": 1 },
    "strata": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["keyword_positive", "keyword_negative", "quotes_code", "subagent_process"] }
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool_call_id", "provider", "name", "args", "result"],
        "properties": {
          "tool_call_id": { "type": "string", "pattern": "^tool-[a-f0-9]{24}$" },
          "provider": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "args": { "type": "object" },
          "result": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "error", "exit_code", "is_error", "http_status", "executed_test_count", "observed_at", "truncated"],
            "properties": {
              "value": {},
              "error": { "type": ["string", "null"] },
              "exit_code": { "type": ["integer", "null"] },
              "is_error": { "type": ["boolean", "null"] },
              "http_status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
              "executed_test_count": { "type": ["integer", "null"], "minimum": 0 },
              "observed_at": { "type": ["string", "null"], "format": "date-time" },
              "truncated": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
